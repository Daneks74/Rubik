# ESPN Fantasy League credentials
# Multiple leagues: comma-separated IDs
ESPN_LEAGUE_IDS=12345,67890
# Or single league (backward compatible):
# ESPN_LEAGUE_ID=12345

# ESPN cookies (optional — app works without them, just no league-specific data)
# Get from browser DevTools > Application > Cookies > espn.com
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={your-swid-here}

SEASON_YEAR=2026

# Optional: The Odds API key for Vegas lines (free tier: https://the-odds-api.com)
# ODDS_API_KEY=your_odds_api_key_here
